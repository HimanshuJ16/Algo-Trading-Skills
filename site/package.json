{
  "name": "algo-trading-skills-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static catalog for the Algo-Trading-Skills library. Generated entirely from index.json and skills/*/SKILL.md.",
  "scripts": {
    "predev": "node scripts/generate-search-index.mjs && node scripts/generate-graph.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-search-index.mjs && node scripts/generate-graph.mjs",
    "build": "next build",
    "preview": "npx --yes serve out",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shikijs/rehype": "^3.9.2",
    "gray-matter": "^4.0.3",
    "lenis": "^1.3.26",
    "next": "^15.5.4",
    "next-themes": "^0.4.6",
    "next-view-transitions": "^0.3.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.23.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
